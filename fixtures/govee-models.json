{
  "schema": "govee-models/1",
  "description": "Shared model classification for Govee BLE lights. The Home Assistant integration (models.py), the Dance Party Flipper app (govee_protocol.c) and the ESP32 image (govee_frames.h) must agree with this file; tools/export_fixtures.py generates the C tables from it and tests/test_fixtures.py checks models.py against it. 'dialect' is the colour sub-mode the current firmware is expected to take; 'pact_decides' means the advertised pact picks 0x0B (pact 1) or 0x15 (pact 2 / 10). 'secret_family' is the decompiled app's secret_key_pairing tag. 'evidence' says how each row is known: hardware (this project's bench), community (a cited capture), app (decompiled-app tables), sibling (placed next to a related SKU, no capture).",
  "dialects": {
    "legacy": {
      "submode": "0x02",
      "brightness_scale": 255
    },
    "rgbww": {
      "submode": "0x0D",
      "brightness_scale": 100
    },
    "rgbic": {
      "submode": "0x15",
      "brightness_scale": 100
    },
    "dreamcolor": {
      "submode": "0x0B",
      "brightness_scale": 100
    }
  },
